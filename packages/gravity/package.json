{
  "name": "@elementalfx/gravity",
  "version": "0.1.0",
  "description": "Gravity mode for any web page: elements fall, collide, tumble and can be thrown around, then spring back into place. Zero dependencies.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/element.js",
    "./dist/*.global.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js"
    },
    "./global": "./dist/gravity.global.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/gravity.global.js",
  "jsdelivr": "./dist/gravity.global.js",
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "gravity",
    "google-gravity",
    "physics",
    "physics-engine",
    "2d-physics",
    "rigid-body",
    "box2d",
    "easter-egg",
    "konami-code",
    "404-page",
    "elementalfx",
    "effects",
    "animation",
    "web-animation",
    "webgl",
    "web-components",
    "custom-elements",
    "framework-agnostic",
    "reduced-motion",
    "typescript"
  ],
  "homepage": "https://avinashiyer4292.github.io/elementalfx/#gravity",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avinashiyer4292/elementalfx.git",
    "directory": "packages/gravity"
  },
  "bugs": {
    "url": "https://github.com/avinashiyer4292/elementalfx/issues"
  },
  "dependencies": {
    "@elementalfx/core": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "elementalfx": {
    "global": "gravity",
    "globalEntry": "src/global.ts",
    "sizeLimit": 13312
  }
}
